# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_portfolio?schema=public

# Authentication Secrets
JWT_SECRET=development-jwt-secret-key-must-be-very-long-and-secure-32-chars
JWT_ISSUER=student-portfolio-api
JWT_AUDIENCE=student-portfolio-client
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Cloud Storage (Cloudinary - for future Phase 6)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
