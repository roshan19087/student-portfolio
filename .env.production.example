# ==============================================================================
# STUDENT DEVELOPER PORTFOLIO - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env.production and fill in real production values.
# NEVER commit real production secrets to version control.

# Node Environment
NODE_ENV=production
PORT=5000
PORT_HTTP=80

# Application URLs & Domains
BASE_URL=https://yourportfolio.com
CORS_ORIGIN=https://yourportfolio.com

# PostgreSQL Database (Docker internal or External RDS/Cloud SQL)
POSTGRES_USER=portfolio_admin
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=student_portfolio
DATABASE_URL=postgresql://portfolio_admin:generate_a_strong_database_password_here@db:5432/student_portfolio?schema=public

# JWT Security Secrets (Generate using: openssl rand -base64 32)
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_string
JWT_REFRESH_SECRET=replace_with_another_distinct_64_character_random_string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Cookies & HTTPS (Set to true when SSL/HTTPS is active)
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Media Storage Provider ('local' or 'cloudinary' or 's3')
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760

# Cloudinary (Optional if using Cloudinary for remote CDN media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=student-portfolio
